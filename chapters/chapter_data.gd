		"lines": [["카이린", "리엘, 오늘 하늘에서… 네가 내 왼쪽을 계속 지켜 줬지."], ["리엘", "기사단 때 버릇이야. 넌 늘 왼쪽이 비었거든."], ["카이린", "…그 버릇, 아직 안 고쳤구나. 고마워."],
			["리엘", "고칠 생각 없어. 끝까지 네 왼쪽은 내 거야."]]},
	{"id": "arin_eileen_b", "a": "아린", "b": "에일린", "after": "ch14", "title": "[B] 자기가 정하는 길",
		"lines": [["에일린", "아린, 선배… 돌아온 거야? 아니면…"], ["아린", "어느 쪽이든, 선배는 자기 길을 골랐어요. 그림자가 아니라 선배가."], ["에일린", "…노아 선배는 늘 그랬지. 마지막엔 자기가 정해."],
			["아린", "이제 내 차례예요. 공주든 아니든, 내가 정할 거예요."]]},
	{"id": "arin_sera_b", "a": "아린", "b": "세라", "after": "ch13", "title": "[B] 해 뜨기 전에",
		"lines": [["세라", "아린… 아무것도 안 먹었잖아요."], ["아린", "세라, 나 누구예요? 공주? 그럼 마을이 불탄 것도 나를 찾으려고…"], ["세라", "아린은 아린이에요. 마을에서 제일 먼저 일어나 검 휘두르던 사람."],
			["아린", "…노아 선배가 늘 그랬어요. 해 뜨기 전에 일어나라고."], ["세라", "그럼 내일도 해 뜨기 전에 일어나요. 선배 데리러 가야죠."]]},
	{"id": "riel_kairin_b", "a": "리엘", "b": "카이린", "after": "ch12", "title": "[B] 혼자 돈 하늘",
		"lines": [["리엘", "카이린, 그동안 혼자서 어떻게 버텼어?"], ["카이린", "매일 밤 성을 한 바퀴 돌았어. 누군가 돌아오길 바라면서."], ["리엘", "…미안해. 내가 먼저 찾았어야 했는데."],
			["카이린", "찾았잖아. 이제 하늘 정찰은 둘이 해. 밤이 덜 길 거야."]]},
	{"id": "boris_greg_s", "a": "보리스", "b": "그렉", "after": "ch11", "title": "[A+] 고향의 거리",
		"lines": [["그렉", "형님, 아까 그 집 애가 형님 다리 붙잡고 안 놓더구먼."], ["보리스", "…나도 저만할 때 저 거리에서 울었지."], ["그렉", "그래서 그렇게 버틴 거유? 창이 세 번 박혀도?"],
			["보리스", "넌 왜 버텼는데."], ["그렉", "형님이 버티니까. 도끼 둘이면 벽 하나 아니유."]]},
	{"id": "mira_leon_a", "a": "미라", "b": "레온", "after": "ch10", "title": "[A] 문 앞의 약속",
		"lines": [["미라", "레온, 아까 문 앞에서… 고마웠어요."], ["레온", "기사로서 당연한 일이다. …아니, 솔직히 말하면 너라서 그랬다."],
			["미라", "이 표식이 뭐든, 레온이 옆에 있으면 무섭지 않아요."], ["레온", "그럼 끝까지 옆에 있지. 약속한다."]]},
	{"id": "luke_eileen_a", "a": "루크", "b": "에일린", "after": "ch9", "title": "[A] 나올 길",
		"lines": [["루크", "에일린. 오늘은 돌아왔네."], ["에일린", "네가 가르쳐 준 대로 했어. 들어갈 때 나올 길부터 봤지."], ["루크", "…솔직히, 그거 듣고 좀 감동했다."],
			["에일린", "왕도에 닿으면 노아 선배 소식도 알 수 있을 거야. 그때까지 내 등 맡아 줄래?"], ["루크", "등이든 뭐든. 둘 다 돌아오기로 했잖아."]]},
	{"id": "arin_sera_c", "a": "아린", "b": "세라", "after": "ch7", "title": "[C] 상처",
		"lines": [["세라", "팔 내밀어 봐요. …또 숨겼죠, 이 상처."], ["아린", "별거 아니에요. 마차가 먼저였으니까."], ["세라", "아린 씨가 쓰러지면 마차도 못 지켜요."],
			["세라", "다음부턴 제가 한 걸음 더 가까이 설게요. 지팡이가 닿는 데까지."], ["아린", "…그럼 저도 한 걸음 덜 무리할게요. 약속."]]},
	{"id": "luke_eileen_b", "a": "루크", "b": "에일린", "after": "ch7", "title": "[B] 둘 다 돌아오기",
		"lines": [["루크", "에일린, 아까 혼자 기병 셋한테 뛰어들었지? 간 떨어지는 줄 알았어."], ["에일린", "노아 선배라면 그렇게 했을 거야."],
			["루크", "노아 선배는 돌아오는 법도 알아. 넌 아직 몰라."], ["에일린", "…그럼 가르쳐 줘. 대신 너도 상자 앞에서 혼자 남지 마."],
			["루크", "좋아. 둘 다 살아서 돌아오기. 손가락 걸어."]]},
	{"id": "boris_greg_a", "a": "보리스", "b": "그렉", "after": "ch8", "title": "[A] 도끼의 벽",
		"lines": [["그렉", "형님, 오늘 계단 앞에서 우리 둘이 선 거 봤수? 개미 한 마리 못 지나갔지."], ["보리스", "나무도 둘이 받치면 안 넘어가는 법이지."],
			["그렉", "고향 숲 다 타 버렸어도… 형님이랑 있으면 다시 심을 수 있을 것 같수."], ["보리스", "전쟁 끝나면 같이 심자. 그때까진 앞을 막는 벽이 되는 거다."],
			["그렉", "도끼 두 자루, 벽 하나. 좋수다."]]},
	{"id": "riel_kairin_c", "a": "리엘", "b": "카이린", "after": "ch16", "title": "[C] 두 날개",
		"lines": [["카이린", "북쪽 능선, 그림자 비룡 다섯. 넌 몇 봤어?"], ["리엘", "여섯. 구름 속에 하나 더 숨어 있었어."],
			["카이린", "…눈은 나보다 낫군. 비행대에서 배운 건가."], ["리엘", "도망치면서 배웠지. 이번엔 쫓는 쪽이 되고 싶어."], ["카이린", "그럼 내일 정찰, 같이 날자."]]},
	{"id": "mira_leon_b", "a": "미라", "b": "레온", "after": "ch8", "title": "[B] 방패 틈",
		"lines": [["레온", "주문을 외울 땐 내 방패 뒤에 서라. 등은 내가 맡는다."], ["미라", "방패 틈으로 새는 놈은 내가 태울게. 그럼 공평하지?"],
			["레온", "…손목, 아직 아픈가."], ["미라", "모른 척해 줘. 대신 오늘 밤 회랑에선 네 왼쪽은 내가 막을게."], ["레온", "약속하지. 내 방패에 빈틈은 없다."]]},
	{"id": "arin_noah", "a": "아린", "b": "노아", "after": "ch1", "title": "새벽 검술",
		"lines": [["노아", "왼발이 또 늦었다."], ["아린", "선배는 왜 맨날 지적만 해요?"], ["노아", "…지적할 게 줄어들고 있으니까."], ["아린", "어? 지금 칭찬한 거죠? 그쵸?"]]},
	{"id": "elia_mira", "a": "엘리아", "b": "미라", "after": "ch2", "title": "라이벌",
		"lines": [["미라", "수석 자리, 언젠가 내가 뺏을 거야."], ["엘리아", "언제든. 근데 그 전에 살아남아."], ["미라", "…걱정하는 거야? 기분 나쁘게."]]},
	{"id": "sera_luke", "a": "세라", "b": "루크", "after": "ch2", "title": "치료비",
		"lines": [["세라", "루크 씨, 또 상자 열다 손 다쳤죠?"], ["루크", "영광의 상처야."], ["세라", "치료비는 다음 보물로 받을게요."]]},
	{"id": "kael_garen", "a": "카엘", "b": "가렌", "after": "ch3", "title": "검의 값",
		"lines": [["카엘", "용병의 검은 돈을 따른다던데."], ["가렌", "그랬지. 지금은 밥값 정도만 받는다."], ["카엘", "…그럼 내 몫의 빵을 나눠 주지."]]},
	{"id": "lina_kai", "a": "리나", "b": "카이", "after": "ch4a", "title": "사냥꾼의 내기",
		"lines": [["카이", "저 까마귀, 먼저 맞히는 쪽이 오늘 저녁 당번 면제."], ["리나", "좋아. …어? 벌써 쐈어?"], ["카이", "사냥은 말보다 빨라야지."]]},
	{"id": "arin_arthur", "a": "아린", "b": "아서", "after": "ch6", "title": "왕성의 기억",
		"lines": [["아서", "네 눈빛, 옛 근위대장을 닮았군."], ["아린", "제 아버지예요. 얼굴은 기억 안 나지만."], ["아서", "…그렇다면 너에게 갚을 빚이 있다."]]},
]
