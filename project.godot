config_version=5

[application]
; Legacy internal name preserves the existing user:// save and settings directory.
config/name="SRPG Prototype"
run/main_scene="res://scenes/title.tscn"
config/features=PackedStringArray("4.3")

[autoload]

Settings="*res://scripts/settings.gd"
SaveManager="*res://scripts/save_manager.gd"
Campaign="*res://scripts/campaign.gd"
Sfx="*res://scripts/audio.gd"

[display]
window/size/viewport_width=720
window/size/viewport_height=1280
window/handheld/orientation=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]
pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[gui]
theme/custom_font="res://assets/fonts/NanumGothic-Bold.ttf"

[rendering]
textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
